	# No log line carries a client's address (ADR 0055, decision 2), for every site, though no access log is on:
	# Caddy's error log (http.log.error) carries the whole request otherwise, its debug lines a remote_ip and
	# remote_port of their own, and the proxy's errors Go's network text, which names both ends of a connection
	# ("write tcp 127.0.0.1:443->192.0.2.7:49235: ..."): every address in an error's text, with its port, becomes
	# ADDR. A message (msg) cannot be filtered: http.log.error's is the handler's error, which names only the
	# upstream here, and Go's own messages, which name the client, come at the debug level only, which stays off.
	log {
		format filter {
			wrap json
			fields {
				request delete
				remote_ip delete
				remote_port delete
				error regexp `\[[0-9A-Fa-f:.%]+[0-9A-Za-z%]*\](:[0-9]+)?|[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]+)?|[0-9A-Fa-f]{0,4}(:[0-9A-Fa-f]{0,4}){2,7}(%[0-9A-Za-z]+)?` ADDR
			}
		}
	}
