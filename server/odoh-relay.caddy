# SPDX-License-Identifier: Apache-2.0
# Datapavan's Oblivious DoH relay (RFC 9230's Oblivious Proxy, ADR 0055), as Caddy configuration alone, for Debian
# 13's Caddy 2.6.2. Two snippets for the Caddyfile's top level; the datapavan.org site imports odoh_relay, and
# odoh-pairs.caddy holds the targets it forwards to. server/README.md says what each rule does and why.

# One allowed target: `import odoh_target ID HOST PATH ENCODED`, ENCODED being PATH with each "/" written "%2F", as
# RFC 9230's URI template expands it (Datapavan's app writes it plain). A request whose whole query is exactly
# targethost=HOST&targetpath=PATH, or the same with ENCODED, goes to https://HOST PATH with its body, the target's
# Host, and Content-Type and Accept of ODoH, and no other header; the target's status and body come back without
# its cookies or any other header of the target's (ODoH's Content-Type is set by odoh_relay).
(odoh_target) {
	@odoh_{args.0} expression `{query} == "targethost={args.1}&targetpath={args.2}" || {query} == "targethost={args.1}&targetpath={args.3}"`
	handle @odoh_{args.0} {
		# The path is a literal, never a request's placeholder: a rewrite that ends in "?" re-expands what it holds
		# (CVE-2026-77281, not fixed in Debian 13's Caddy).
		rewrite * {args.2}?
		# Every header of the client's goes. A field of "**" means every field in Caddy 2.6.2, where a lone "*"
		# fails; it runs before the proxy's own headers, whose deletions would come after its settings.
		# The trailers a client declares are not headers: their names reach the target, never their values.
		request_header -**
		reverse_proxy https://{args.1} {
			# The whole body is read before the target is asked, so that a slow client holds no request open there;
			# odoh_relay's length check and request_body bound it at 65,604 bytes.
			buffer_requests
			# The headers Caddy's proxy adds by itself go too; then the three that ODoH needs.
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up Host {args.1}
			header_up Content-Type application/oblivious-dns-message
			header_up Accept application/oblivious-dns-message
			# Present but empty, so that Go's HTTP client sends no User-Agent of its own.
			header_up User-Agent ""
			# Every header of the target's goes (cookies, Server, CORS, Clear-Site-Data, reporting, Location...):
			# nothing it writes is served under datapavan.org's origin but the status and the body.
			header_down -**
			transport http {
				tls_server_name {args.1}
				compression off
				dial_timeout 5s
				response_header_timeout 10s
			}
		}
	}
}

# The relay's one path. Any other method, type or size, and any query that is not exactly one allowed target, gets
# a 4xx before anything is contacted.
(odoh_relay) {
	handle /odoh/proxy {
		# Caddy's own Server header too, whatever the site sets, and ODoH's type on what comes back: deferred, these
		# run as the response is written, after the proxy's deletions.
		header {
			-Server
			Content-Type application/oblivious-dns-message
		}
		@odoh_not_post not method POST
		@odoh_not_type not header Content-Type application/oblivious-dns-message
		# RFC 9230's largest message: 1 byte of type, a key id of at most 64 bytes (HKDF-SHA512's) and an encrypted
		# message of at most 65,535, each with a length of 2 bytes: 65,604. A body without a length is refused too.
		@odoh_not_size not expression `{http.request.header.Content-Length}.matches("^[1-9][0-9]{0,4}$") && int({http.request.header.Content-Length}) <= 65604`
		route {
			respond @odoh_not_post 405
			respond @odoh_not_type 415
			respond @odoh_not_size 413
			request_body {
				max_size 65604
			}
			import odoh_pairs
			respond 403
		}
	}
}
