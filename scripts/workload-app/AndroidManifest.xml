<?xml version="1.0" encoding="utf-8"?>
<!--
    W6's workload app (scripts/verify-chain.sh): an ordinary installed app with a UID of its own, which the
    check picks on Watch's chain screen as a user would. On request it looks a name up through Android's
    resolver, sends an HTTP request over TCP and a UDP datagram, and logs what came back. Emulators only;
    never shipped.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.visadahyu.datapavan.workload">

    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="Datapavan workload" android:hasCode="true">
        <!-- A launcher entry: Watch offers the apps a user can open (ADR 0034). -->
        <activity android:name=".WorkActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
