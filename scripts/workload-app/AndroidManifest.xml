<?xml version="1.0" encoding="utf-8"?>
<!--
    W6's workload app (scripts/verify-chain.sh): an ordinary installed app with a UID of its own, which the
    check picks on the network part's chain screen as a user would. On request it looks a name up through Android's
    resolver, sends an HTTP request over TCP and a UDP datagram, and logs what came back. W5's live view
    (scripts/verify-activity.sh) builds it under two more package names, each an app of its own, which send
    while on screen, in the background, and from a foreground service with its notification. Emulators only;
    never shipped. Class names are written in full, so that the copies under other package names find them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.visadahyu.datapavan.workload">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The foreground service of verify-activity.sh, and its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="Datapavan workload" android:hasCode="true">
        <!-- A launcher entry: the network part offers the apps a user can open (ADR 0034). -->
        <activity android:name="org.visadahyu.datapavan.workload.WorkActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Sends in the background, as a job, with no notification, on a connection opened while on screen. -->
        <service
            android:name="org.visadahyu.datapavan.workload.SendJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Sends from a foreground service, which shows its notification. -->
        <service android:name="org.visadahyu.datapavan.workload.NoticeService" android:exported="false" />
    </application>
</manifest>
