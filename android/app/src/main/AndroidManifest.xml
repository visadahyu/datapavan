<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        No Android platform permissions in v0.1: the app cannot open network connections.
        (AndroidX adds one app-internal signature permission for non-exported receivers.)
        allowBackup=false disables cloud backup. Device-to-device transfer must be excluded
        separately on Android 12+, which data_extraction_rules does; backup_rules is required by
        Lint for Android 10-11 and excludes everything as well.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Datapavan">

        <!--
            EmojiCompat would look up a downloadable emoji font through the Google Play services
            font provider on every start. Datapavan never talks to Google, so it is disabled.
            The provider comes from androidx.startup, which build.gradle.kts declares directly.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
