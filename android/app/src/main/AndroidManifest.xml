<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        v0.1 permissions (ADR 0014). None of them allows a network connection; INTERNET stays
        forbidden by the build. (AndroidX adds one app-internal signature permission for
        non-exported receivers.)
        allowBackup=false disables cloud backup. Device-to-device transfer must be excluded
        separately on Android 12+, which data_extraction_rules does; backup_rules is required by
        Lint for Android 10-11 and excludes everything as well.
    -->
    <!-- See every installed app; an audit with a filtered list would be incomplete by design. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!--
        Usage access: network use per app and when each app was last used (ADR 0022). Special access
        that the user grants in Settings; Datapavan works without it.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Tell whether a VPN is active. A normal permission that allows no connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Android 12 and later: other apps' overlays are hidden while this app's windows are shown, so that
        no app drawn over it can dress or read its screens (ADR 0040). A normal permission that allows no
        connection and nothing outside this app's own windows.
    -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="${appIcon}"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Datapavan">

        <!--
            EmojiCompat would look up a downloadable emoji font through the Google Play services
            font provider on every start. Datapavan never talks to Google, so it is disabled.
            The provider comes from androidx.startup, which build.gradle.kts declares directly.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The launcher shortcuts: the plan, the apps and network use (ui/Shortcuts.kt). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            The parsers of untrusted input (ADR 0045, decision 9): other apps' DEX files and ZIP
            directories, and the key-attestation extension, in an isolated process with no permissions,
            no network and none of this app's files. It gets each APK as a file descriptor
            (audit/ParserService.kt). build.gradle.kts fails the build unless it stays isolated.
        -->
        <service
            android:name=".audit.ParserService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":parser" />
    </application>
</manifest>
