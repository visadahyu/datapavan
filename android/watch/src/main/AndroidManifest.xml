<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Watch (ADR 0029, ADR 0045): the tunnel, its log and the chain, the part of Datapavan Advanced
        that uses the network. Only Advanced includes this library. Its permissions are those of ADR
        0034; app/build.gradle.kts fails the build if Advanced's merged manifest holds any other, and if
        Basic's holds any of these that Basic does not allow. The application's own manifest sets the
        backup rules, which exclude everything, the icon, the label and the theme.
    -->
    <!-- Sockets, to pass each app's traffic on to where it was going. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Which network is beneath the tunnel, its DNS server, and when it changes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Android 10 and 11 only: Watch is inside its own tunnel, so it follows the network beneath
        with requestNetwork, which needs this. From Android 12 a best-matching callback does without.
    -->
    <uses-permission
        android:name="android.permission.CHANGE_NETWORK_STATE"
        android:maxSdkVersion="30" />
    <!--
        Android 17: every app's traffic to the local network (a printer, a TV, the router's page) leaves
        through Watch's sockets, which Android checks as Watch's (ADR 0034).
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!--
        Android 12 and later: other apps' overlays are hidden while this app's windows are shown, so that
        no app drawn over it can dress or read its screens (ADR 0040). A normal permission that allows no
        connection and nothing outside this app's own windows.
    -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!--
        Package visibility (ADR 0034): every app a user can open, so that Watch finds the user's tool of
        the table (data/tools) and lists the apps the user may chain through it (W6). Not
        QUERY_ALL_PACKAGES; Watch writes no list of apps anywhere.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>

        <!--
            EmojiCompat would look up a downloadable emoji font through the Google Play services font
            provider on every start. Datapavan never talks to Google, so it is disabled, as in the
            audit app.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <!--
            Watch runs in a process of its own, ":watch": its screen, its tunnel and its log's expiry. The
            part that faces the network then shares no memory with the audit, a crash of either leaves the
            other running, and Watch keeps its own memory budget (scripts/verify-watch-release.sh). They
            talk only through the intent that opens Watch's screen.

            Watch's screen, opened from the audit's network page. Not exported: Advanced has one launcher
            entry, the audit's. Debug builds export it for the emulator checks (src/debug).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:process=":watch"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Watch" />

        <!-- Only Android may bind to it (BIND_VPN_SERVICE). -->
        <service
            android:name=".WatchVpnService"
            android:exported="false"
            android:process=":watch"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Watch may be the always-on VPN (docs/VPN.md, "Connectivity and fail mode"). -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <!-- The connection log's expiry, on days nothing else starts Watch (ADR 0037). Only Android may bind to it. -->
        <service
            android:name=".log.LogExpiryJob"
            android:exported="false"
            android:process=":watch"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
