<?xml version="1.0" encoding="utf-8"?>
<!--
    ADR 0054 (Android's own labels, read from the phone): the sentences of Advanced's network monitoring that quote a
    label of Android's own screens, which the label now fills as Android names it on this phone, and the lines around
    them. In English only. They are translated into the seven other languages by ADR 0030's process before the merge,
    and then move into strings.xml, where scripts/check-translations.py holds them to every language; until then this
    file is held to the plain-language gate (scripts/check.sh), and lint's check for missing translations is lifted for
    it alone. A release needs it empty (RELEASE.md). The sentences they replace stay readable, with their translations,
    at b382014. Where a sentence needs a subject, it is Datapavan.

    For the translators: each label placeholder is a label of Android's own screens, read from the phone in its own
    language, or Android's text in Datapavan's language where the phone gives none (android_label_* in strings.xml,
    which are copied from AOSP, never translated). It is always in the language's quotes, as this file's \"…\", and
    after a noun (the setting, the switch) or a verb of naming ("call it"), so that no word around it depends on its
    gender, number or case: Russian and German keep it in the nominative, Arabic adds no ال to it, and Persian puts no
    ezafe on it. Two exceptions: Private DNS's choices follow "to" and "is" in chain_private_dns_quoted and
    dns_private_dns_strict_quoted, where Russian and Arabic may set "the choice" before them. One placeholder may hold
    two labels, the phone's then Datapavan's in brackets, as label_with_own sets them: put nothing of the sentence's
    grammar on it. Persian's labels write VPN in Latin letters, as AOSP does, where Datapavan's own sentences write it in
    Persian ones: keep both as they are.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- A label read in the phone's language (%1$s), then the same label in Datapavan's language (%2$s), where the two
         differ: Android's labels and the tools' in the per-tool guides. Chinese takes full-width brackets. -->
    <string name="label_with_own">%1$s (%2$s)</string>
    <!-- Under a part that names Android's own settings or switches, where some of those names are Android's own rather
         than this phone's: Datapavan has not seen this phone's maker show them, or the phone gave none. %1$s: those
         names, each as label_named gives it, joined by labels_list_separator. -->
    <string name="labels_android_note">These are Android\'s own names, and your phone may show others: %1$s.</string>
    <!-- One name in the list of labels_android_note, in the language's quotes. -->
    <string name="label_named">\"%1$s\"</string>
    <!-- Between the names in labels_android_note. -->
    <string name="labels_list_separator">", "</string>
    <!-- In "Now", under the line that Datapavan has no usage access, before the button that opens Android's page for it:
         Datapavan's name for the access is kept, and this line gives the phone's own (the maintainer, 2026-11-22). %1$s:
         the page's name in this phone's Settings, "Usage access" to Android 15 and "App usage data" from 16. -->
    <string name="now_access_phone_name">This phone\'s settings call it \"%1$s\".</string>
    <!-- After Android refused the VPN consent, or another app's always-on VPN kept Datapavan's VPN from starting.
         %1$s: Android's always-on switch on a VPN's settings page. -->
    <string name="consent_refused_quoted">Android did not let Datapavan start its VPN. If the \"%1$s\" switch is on for another VPN app, turn it off first.</string>
    <!-- Private DNS set to a provider by name, %1$s (for example dns.google); %2$s: Android's name for the setting.
         Datapavan does not ask the user to change it. -->
    <string name="private_dns_strict_quoted">This phone\'s \"%2$s\" setting points to %1$s. Android sends the names that apps look up there, encrypted. This keeps them private from your network, but Datapavan cannot read them.</string>
    <!-- Shown when the phone's Private DNS is set to a provider's host name. %1$s: that host name, such as dns.google.
         %2$s: the tool's name. %3$s: Android's name for the setting; %4$s and %5$s: its choices Automatic and Off. -->
    <string name="chain_private_dns_quoted">This phone\'s \"%3$s\" setting points to %1$s. Android then sends the names that apps look up to %1$s itself, encrypted, past Datapavan and past %2$s. Your network cannot read those names, but it can see that this phone uses %1$s. And %1$s sees the names and your real address on the internet. For the apps you send through %2$s, change the \"%3$s\" setting to \"%4$s\" or \"%5$s\".</string>
    <!-- Under it, before a button that opens Android's network settings, which differ between phone makers. %1$s:
         Android's name for the setting. -->
    <string name="chain_private_dns_where_quoted">Look for the \"%1$s\" setting in the settings that open. On some phones it is one step further in.</string>
    <!-- %1$s: the host name of Android's Private DNS provider. %2$s: Android's name for the setting; %3$s and %4$s: its
         choices Off and Automatic. -->
    <string name="dns_private_dns_strict_quoted">Android\'s \"%2$s\" setting sends every app\'s names to %1$s, past Datapavan. Your choice here applies only while that setting is \"%3$s\" or \"%4$s\".</string>
    <!-- %1$s: Android's always-on switch on a VPN's settings page. -->
    <string name="dns_strict_limits_quoted">Strict does not cover everything. Android checks the connection by itself, past Datapavan. Some apps use their own encrypted DNS. The apps you left out are not covered. And while Datapavan restarts its VPN, or if Android stops it while its \"%1$s\" switch is off, apps use the network\'s resolver.</string>
    <!-- A configuration's server given by name. %1$s: Android's name for the Private DNS setting. -->
    <string name="import_server_name_quoted">Datapavan looks up this name through your network before the tunnel starts. If the \"%1$s\" setting is off, your network may see it.</string>
    <!-- The phone has no screen lock (a PIN, pattern or password). %1$s: Android's name for the setting (Settings,
         Security). -->
    <string name="log_no_screen_lock_quoted">This phone has no PIN, pattern or password set under the \"%1$s\" setting, so records of earlier days can be opened at any time. With one, they open only while the phone is unlocked.</string>
</resources>
