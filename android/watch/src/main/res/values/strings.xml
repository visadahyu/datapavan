<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The product's name, the same in every language (docs/NAMES.md). -->
    <string name="app_name" translatable="false">Datapavan Watch</string>
    <string name="tagline">See where each app on your phone connects.</string>
    <!-- Whether Watch's VPN is running. -->
    <string name="status_on">Watch is on.</string>
    <string name="status_off">Watch is off.</string>
    <string name="turn_on">Turn on</string>
    <string name="turn_off">Turn off</string>
    <!-- After Android refused the VPN consent, or another app's always-on VPN kept Watch from starting. -->
    <string name="consent_refused">Android did not let Watch start. If another VPN app is set to stay always on, turn that setting off first.</string>
    <!-- The heading of a note shown while Watch is on: Android's own name for the setting (Settings, Network and internet). -->
    <string name="private_dns">Private DNS</string>
    <!-- Private DNS set to a provider by name, %1$s (for example dns.google). Watch does not ask the user to change it. -->
    <string name="private_dns_strict">Your phone\'s Private DNS is set to %1$s. Android sends the names that apps look up there, encrypted. This keeps them private from your network, but Watch cannot read them.</string>
    <!-- Private DNS on "Automatic", and the network's DNS server supports encryption, so Android uses it. -->
    <string name="private_dns_network">Your network\'s DNS server supports encryption, and Android uses it for the names that apps look up. This keeps them private, but Watch cannot read them.</string>
    <!-- Shown after either of the two above. -->
    <string name="private_dns_still_named">Watch still names most connections from what each app sends, or by who runs the network they reach.</string>
    <!-- The heading of the connection log's settings (W4). -->
    <string name="log_title">Connection log</string>
    <!-- Under the heading, while the log keeps records. One of the three sentences after it follows, whichever holds on this phone. -->
    <string name="log_encrypted">Watch keeps a record of each connection on this phone, in encrypted form.</string>
    <!-- The phone has a screen lock (a PIN, pattern or password), and the log's key works only while the phone is unlocked. -->
    <string name="log_locked">Records of earlier days can be opened only while the phone is unlocked.</string>
    <!-- The phone has no screen lock. "Screen lock" is Android's own name for the setting (Settings, Security). -->
    <string name="log_no_screen_lock">This phone has no screen lock, so records of earlier days can be opened at any time. With a screen lock, they open only while the phone is unlocked.</string>
    <!-- The phone did not allow a key that works only while it is unlocked, so the log's key works at any time. -->
    <string name="log_lock_refused">This phone did not let Watch tie the records to its screen lock, so records of earlier days can be opened at any time.</string>
    <!-- Under the heading, instead of the sentences above, when the user chose to keep no records. -->
    <string name="log_not_kept">Watch keeps no record of connections.</string>
    <!-- The heading of the choice of how long the log keeps its records. -->
    <string name="log_keep">Keep records for</string>
    <string name="log_keep_none">Don\'t keep any</string>
    <plurals name="log_keep_days">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <string name="log_delete">Delete the log now</string>
    <!-- Shown after the user deleted the log. -->
    <string name="log_deleted">The log is deleted.</string>
    <!-- W6: Watch beside the user's circumvention tool (a VPN or proxy app used to get past network filtering). The heading. -->
    <string name="chain_title">Your circumvention tool</string>
    <!-- While Watch looks for an installed tool whose proxy answers. -->
    <string name="chain_searching">Looking for a circumvention tool in proxy mode…</string>
    <!-- No tool of Watch's list with a proxy mode is installed. Android runs one VPN at a time. -->
    <string name="chain_none">No circumvention tool with a proxy mode is installed. Android runs only one VPN at a time, so Watch can work beside such a tool only through its proxy mode.</string>
    <!-- %1$s: the names of the installed tools, comma separated. Their proxy does not answer. -->
    <string name="chain_not_answering">Installed: %1$s. No proxy answers. Run the tool in proxy mode instead of VPN mode, then look again.</string>
    <!-- The chain is on, but the tool's proxy does not answer. %1$s: the tool's name. -->
    <string name="chain_waiting">%1$s does not answer. The apps you send through it wait, and nothing of theirs goes out directly.</string>
    <!-- A button: look for the tool again. -->
    <string name="chain_search_again">Look again</string>
    <!-- %1$s: the tool's name; %2$d: the port of its proxy on this phone. -->
    <string name="chain_found">%1$s answers on port %2$d of this phone.</string>
    <!-- A switch. %1$s: the tool's name. -->
    <string name="chain_switch">Send apps through %1$s</string>
    <!-- Two choices: which apps go through the tool. -->
    <string name="chain_all_apps">Every app</string>
    <string name="chain_some_apps">Only the apps I choose</string>
    <!-- %1$s: the tool's name. It cannot carry UDP (Tor, for example). -->
    <string name="chain_no_udp">%1$s cannot carry UDP. Calls and some games in the apps you send through it will not work. Web pages still load.</string>
    <!-- Shown when the phone's Private DNS is set to a provider's host name. -->
    <string name="chain_private_dns">Your phone\'s Private DNS sends the names apps look up past Watch and past your tool. For the apps you send through the tool, set Private DNS to Automatic or Off.</string>
    <!-- %1$s: the tool's name. Watch offers a password for the tool's proxy. -->
    <string name="chain_password">To keep other apps on this phone off the proxy of %1$s, set this user name and password in %1$s.</string>
    <!-- %1$s: the user name, such as watch. -->
    <string name="chain_user">User name: %1$s</string>
    <!-- %1$s: the password Watch made. -->
    <string name="chain_password_value">Password: %1$s</string>
    <!-- A button: copy the password, to paste it in the tool. -->
    <string name="chain_copy">Copy the password</string>
    <!-- A switch, off unless the user turns it on. -->
    <string name="chain_log_destinations">Log where these apps connect</string>
    <!-- Under the switch above. -->
    <string name="chain_log_destinations_note">Off unless you turn it on. Watch still counts their connections. A list of where they went can be used against you if someone searches your phone.</string>
</resources>
