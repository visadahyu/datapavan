<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The product's name, the same in every language (docs/NAMES.md). -->
    <string name="app_name" translatable="false">Datapavan Watch</string>
    <string name="tagline">See where each app on your phone connects.</string>
    <!-- Whether Watch's VPN is running. -->
    <string name="status_on">Watch is on.</string>
    <string name="status_off">Watch is off.</string>
    <string name="turn_on">Turn on</string>
    <string name="turn_off">Turn off</string>
    <!-- After Android refused the VPN consent, or another app's always-on VPN kept Watch from starting. -->
    <string name="consent_refused">Android did not let Watch start. If another VPN app is set to stay always on, turn that setting off first.</string>
    <!-- The heading of a note shown while Watch is on: Android's own name for the setting (Settings, Network and internet). -->
    <string name="private_dns">Private DNS</string>
    <!-- Private DNS set to a provider by name, %1$s (for example dns.google). Watch does not ask the user to change it. -->
    <string name="private_dns_strict">Your phone\'s Private DNS is set to %1$s. Android sends the names that apps look up there, encrypted. This keeps them private from your network, but Watch cannot read them.</string>
    <!-- Private DNS on "Automatic", and the network's DNS server supports encryption, so Android uses it. -->
    <string name="private_dns_network">Your network\'s DNS server supports encryption, and Android uses it for the names that apps look up. This keeps them private, but Watch cannot read them.</string>
    <!-- Shown after either of the two above. -->
    <string name="private_dns_still_named">Watch still names most connections from what each app sends, or by who runs the network they reach.</string>
    <!-- The heading of the connection log's settings (W4). -->
    <string name="log_title">Connection log</string>
    <string name="log_explained">Watch keeps a record of each connection on this phone, in encrypted form. Records of earlier days can be opened only while the phone is unlocked.</string>
    <!-- The heading of the choice of how long the log keeps its records. -->
    <string name="log_keep">Keep records for</string>
    <string name="log_keep_none">Don\'t keep any</string>
    <plurals name="log_keep_days">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <string name="log_delete">Delete the log now</string>
    <!-- Shown after the user deleted the log. -->
    <string name="log_deleted">The log is deleted.</string>
</resources>
