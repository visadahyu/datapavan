<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 blocks private addresses (the test server on the LAN) without it, for apps targeting 37. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Plain HTTP to the test server on the development computer, nowhere else. -->
    <application android:label="Watch load" android:allowBackup="false" android:usesCleartextTraffic="true">
        <activity android:name=".LoadActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
